############################################################
## ARO112 LOAD DISTRIBUTION
############################################################

library(ggplot2)
library(dplyr)

############################################################
## Load data
############################################################

loads <- donnees

############################################################
## Remove invalid values
############################################################

loads <- loads %>%
    filter(
        loads > 0
    )

############################################################
## Log10 transformation
############################################################

loads <- loads %>%
    mutate(
        log10_loads = log10(loads)
    )

############################################################
## Fit Gaussian distribution
############################################################

mean_load <- mean(
    loads$log10_loads
)

sd_load <- sd(
    loads$log10_loads
)

############################################################
## Gaussian maximum
############################################################
##
## For a normal distribution, the maximum of the
## Gaussian curve corresponds to the mean.
##
############################################################

gaussian_peak <- mean_load

############################################################
## Rounded value for display
############################################################

gaussian_peak_label <- round(
    gaussian_peak,
    1
)

############################################################
## X-axis breaks
############################################################

x_breaks <- sort(
    unique(
        c(
            6,
            7,
            8,
            gaussian_peak_label,
            9,
            10
        )
    )
)

############################################################
## Plot
############################################################

plot_load_distribution <- ggplot(
    loads,
    aes(
        x = log10_loads
    )
) +
    
    ########################################################
## Histogram
########################################################

geom_histogram(
    aes(
        y = after_stat(density)
    ),
    bins = 30,
    colour = "black",
    fill = "grey80"
) +
    
    ########################################################
## Gaussian curve
########################################################

stat_function(
    fun = dnorm,
    args = list(
        mean = mean_load,
        sd = sd_load
    ),
    linewidth = 1
) +
    
    ########################################################
## Gaussian maximum
########################################################

geom_vline(
    xintercept = gaussian_peak,
    linetype = "dashed",
    linewidth = 1
) +
    
    ########################################################
## X-axis
########################################################

scale_x_continuous(
    breaks = x_breaks,
    labels = function(x) {
        
        ifelse(
            abs(x - gaussian_peak_label) < 0.001,
            sprintf(
                "%.1f",
                gaussian_peak_label
            ),
            sprintf(
                "%.0f",
                x
            )
        )
    }
) +
    
    ########################################################
## Labels
########################################################

labs(
    title = "ARO112 load distribution",
    x = expression(
        log[10]~"(ARO112 load)"
    ),
    y = "Density"
) +
    
    ########################################################
## Theme
########################################################

theme_classic(
    base_size = 14
) +
    
    theme(
        plot.title = element_text(
            hjust = 0
        )
    )

############################################################
## Display
############################################################

plot_load_distribution
