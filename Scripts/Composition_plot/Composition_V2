#############################################################
## 2. Packages
#############################################################

library(dplyr)
library(ggplot2)
library(grid)
library(phyloseq)
library(scales)
library(tidyr)

#############################################################
## Input phyloseq object
#############################################################

ps <- ps_RD03050910

#############################################################
## Optional filtering
#############################################################

experiment <- c("RD03","RD09","RD10")

exclude_cages <- NULL

exclude_groups <- NULL

exclude_days <- "d19"

exclude_conditions <- data.frame(
        group = c("Antibiotic","Antibiotic","Antibiotic","Untreated","Untreated","Untreated","Untreated"),      
        day   = c("d1","d7","d13","d-1","d1","d7","d13")
        )

## Examples:
##
## exclude_days <- c("d-4","d-1")
##
## exclude_conditions <- data.frame(
##     group = c("Antibiotic","Antibiotic","Antibiotic"),
##     day   = c("d1","d7","d13")
## )

#############################################################
## Optional experiment filtering
#############################################################

if (!is.null(experiment)) {

    ps <- subset_samples(
        ps,
        exp %in% experiment
    )

}

#############################################################
## Optional cage filtering
#############################################################

if (!is.null(exclude_cages)) {

    ps <- subset_samples(
        ps,
        !(cage %in% exclude_cages)
    )

}
#############################################################
## Optional group filtering
#############################################################

if (!is.null(exclude_groups)) {

    ps <- subset_samples(
        ps,
        !(group %in% exclude_groups)
    )

}

#############################################################
## Optional day filtering
#############################################################

if (!is.null(exclude_days)) {

    ps <- subset_samples(
        ps,
        !(day %in% exclude_days)
    )

}

#############################################################
## Optional combination filtering
#############################################################

if (!is.null(exclude_conditions)) {

    metadata <- data.frame(sample_data(ps))

#############################################################
## Check combination variables.
#############################################################

    missing_variables <- setdiff(
        names(exclude_conditions),
        colnames(metadata)
    )

    if (length(missing_variables) > 0) {

        stop(
            paste(
                "Unknown variable(s):",
                paste(missing_variables, collapse = ", ")
            )
        )

    }

    keep <- rep(TRUE, nrow(metadata))

    for (i in seq_len(nrow(exclude_conditions))) {

        remove <- rep(TRUE, nrow(metadata))

        for (variable in names(exclude_conditions)) {

            remove <- remove &
                metadata[[variable]] == exclude_conditions[i, variable]

        }

        keep <- keep & !remove

    }

    ps <- prune_samples(keep, ps)

}

    
    #############################################################
    ## Load MicrobiomeTools functions
    #############################################################
    
    source("R/microbiome_palette.R")
    source("R/microbiome_theme.R")
    source("R/create_taxon_names.R")
source("R/taxonomy_database.R")
    
    #############################################################
    ## Modify only the parameters below
    #############################################################
    #############################################################
    ## 3. Parameters
    #############################################################
    
    ## Taxonomic level
      tax_level <- "Genus"
      
    ## Number of most abundant taxa to display.
    ## Remaining taxa are merged into "Other".
    top_taxa <- 20
      
    ## Sample metadata
      group_var <- "group"
      day_var <- "day"
    
    ## Day order
    day_order <- c(
      "d-4",
      "d-1",
      "d1",
      "d7",
      "d13"
    )
    
    group_order <- c(
        "Untreated",
        "Antibiotic",
        "WT",
        "lsrK",
        "lsrR"
    )
    
    #############################################################
    #############################################################
    
    ## Export options
    figure_width  <- 12
    figure_height <- 5
    figure_dpi    <- 600
    
    export_figure <- TRUE
    
    ## Figure title
    figure_title <- "Genus composition"
    
    ## Output filename
    output_name <- "Composition_plot"
    
    output_directory <- "Figures"
    
    #############################################################
    ## End of user parameters
    #############################################################
    
    #############################################################
    ## Validate user parameters
    #############################################################

valid_tax_levels <- c(
  "Kingdom",
  "Phylum",
  "Class",
  "Order",
  "Family",
  "Genus",
  "Species"
)

if (!tax_level %in% valid_tax_levels) {

  stop(
    paste(
      "Invalid tax_level:",
      tax_level
    )
  )

}

#############################################################
## Check required input
#############################################################

if (!exists("ps")) {

  stop(
    "The phyloseq object 'ps' was not found."
  )

}

#############################################################
## 4. Data preparation
#############################################################

## Select experiment (if specified)

if (!is.null(experiment)) {

 ps <- subset_samples(
    ps,
    exp %in% experiment
)

} else {

  ps <- ps

}

## Remove taxa with zero counts

ps <- prune_taxa(
  taxa_sums(ps) > 0,
  ps
)

if (nsamples(ps) == 0) {

  stop(
    "No samples found after filtering."
  )

}

## Transform counts to relative abundance

ps.rel <- transform_sample_counts(
  ps,
  function(x) x / sum(x)
)

## Aggregate taxa

ps.rel <- tax_glom(
  ps.rel,
  taxrank = tax_level,
  NArm = FALSE
)

## Convert phyloseq object to data frame

df <- psmelt(ps.rel)

#############################################################
## Create Taxon column
#############################################################

df <- psmelt(ps.rel)

df$Taxon <- create_taxon_names(
    df,
    tax_level
)

## Check required columns

required_columns <- c(
  "Sample",
  "Abundance",
  group_var,
  day_var,
  tax_level
)

missing_columns <- setdiff(
  required_columns,
  colnames(df)
)

if (length(missing_columns) > 0) {

  stop(
    paste(
      "Missing columns:",
      paste(missing_columns,
            collapse = ", ")
    )
  )

}

#############################################################
## 5. Mean abundance calculation
#############################################################

## Sum abundance within each sample

df_sample <- df %>%
  group_by(
    Sample,
    .data[[day_var]],
    .data[[group_var]],
    Taxon
  ) %>%
  summarise(
    Abundance = sum(Abundance),
    .groups = "drop"
  )

## Calculate mean abundance for each day and group

df_mean <- df_sample %>%
  group_by(
    .data[[day_var]],
    .data[[group_var]],
    Taxon
  ) %>%
  summarise(
    MeanAbundance = mean(Abundance),
    .groups = "drop"
  )


#############################################################
## 6. Top taxa selection
#############################################################

## Calculate the total abundance of each taxon

top_taxa_list <- df_mean %>%
  group_by(Taxon) %>%
  summarise(
    TotalAbundance = sum(MeanAbundance),
    .groups = "drop"
  ) %>%
  arrange(desc(TotalAbundance)) %>%
  slice_head(n = top_taxa) %>%
  pull(Taxon)

## Merge remaining taxa into "Other"

df_plot <- df_mean %>%
  mutate(
    Taxon = if_else(
      Taxon %in% top_taxa_list,
      Taxon,
      "Other"
    )
  ) %>%
  group_by(
    .data[[day_var]],
    .data[[group_var]],
    Taxon
  ) %>%
  summarise(
    MeanAbundance = sum(MeanAbundance),
    .groups = "drop"
  )

#############################################################
## Taxon - Phylum correspondence
#############################################################

## Recover the Phylum associated with each displayed taxon
## directly from the phyloseq taxonomy table.

taxon_phylum <- df %>%
    select(Taxon, Phylum) %>%
    distinct() %>%
    mutate(
        Taxon = as.character(Taxon),
        Phylum = standardize_phylum(Phylum)
    )

#############################################################
## Phylum order
#############################################################

phylum_order <- c(
    "Bacteroidota",
    "Bacillota",
    "Pseudomonadota",
    "Verrucomicrobiota",
    "Actinobacteriota",
    "Deferribacterota",
    "Desulfobacterota",
    "Fusobacteriota",
    "Patescibacteria",
    "Deinococcota"
)

#############################################################
## Biological ordering of taxa
#############################################################

taxa_order <- df_plot %>%
    
    left_join(
        taxon_phylum,
        by = "Taxon"
    ) %>%
    
    mutate(
        Phylum = factor(
            Phylum,
            levels = phylum_order
        )
    ) %>%
    
    group_by(
        Phylum,
        Taxon
    ) %>%
    
    summarise(
        TotalAbundance = sum(
            MeanAbundance,
            na.rm = TRUE
        ),
        .groups = "drop"
    ) %>%
    
    arrange(
        Phylum,
        desc(TotalAbundance)
    ) %>%
    
    pull(Taxon)

#############################################################
## Always display "Other" last
#############################################################

taxa_order <- c(
    setdiff(taxa_order, "Other"),
    "Other"
)
#############################################################
## Check taxon-phylum correspondence
#############################################################

df_plot %>%
    distinct(Taxon) %>%
    left_join(
        taxon_phylum,
        by = "Taxon"
    ) %>%
    arrange(Phylum, Taxon)

#############################################################
## Convert Taxon to ordered factor
#############################################################

df_plot$Taxon <- factor(
    df_plot$Taxon,
    levels = rev(taxa_order)
)
#############################################################
## 7. Colour palette
#############################################################
#############################################################
## Official MicrobiomeTools palette
#############################################################

taxon_colors <- microbiome_palette(
    taxonomy = taxon_phylum %>%
        filter(
            Taxon %in% levels(df_plot$Taxon)
        )
)

taxon_colors <- taxon_colors[
    levels(df_plot$Taxon)
]

#############################################################
## 8. Create figure
#############################################################

df_plot[[day_var]] <- factor(
  df_plot[[day_var]],
  levels = day_order
)

df_plot[[group_var]] <- factor(
  df_plot[[group_var]],
  levels = group_order
)
  
composition_plot <- ggplot(
  df_plot,
  aes(
    x = .data[[day_var]],
    y = MeanAbundance,
    fill = Taxon
  )
) +

geom_col(
  colour = "black",
  linewidth = 0.2,
  width = 0.9
) +

facet_wrap(
  vars(.data[[group_var]]),
  nrow = 1,
  scales = "free_x"
) +

scale_x_discrete(drop = TRUE) +

scale_y_continuous(
  labels = scales::percent_format(accuracy = 1),
  expand = expansion(mult = c(0, 0.02))
) +

scale_fill_manual(
    values = taxon_colors
) +

guides(
    fill = guide_legend(
        ncol = 1
    )
) +

labs(
    title = figure_title,
    x = "Day",
    y = "Relative abundance",
    fill = tax_level
) +

microbiome_theme()
  
  composition_plot

#############################################################
## 9. Export figure
#############################################################

if (export_figure) {

  ## Create output directory if it does not exist

  dir.create(
    output_directory,
    showWarnings = FALSE,
    recursive = TRUE
  )

  ## Export figure

  ggsave(
    filename = file.path(
      output_directory,
      paste0(output_name, ".png")
    ),
    plot = composition_plot,
    width = figure_width,
    height = figure_height,
    dpi = figure_dpi
  )

}

