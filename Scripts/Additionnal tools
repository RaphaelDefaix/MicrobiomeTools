## Export ##
metadata <- data.frame(sample_data(ps))

write.csv2(
    metadata,
    "metadata.csv",
    row.names = TRUE
)


## Import ##

metadata_new <- read.csv2(
    "metadata.csv",
    row.names = 1,
    stringsAsFactors = FALSE,
    check.names = FALSE
)

stopifnot(
    all(rownames(metadata_new) == sample_names(ps))
)

sample_data(ps) <- sample_data(metadata_new)

## ##
