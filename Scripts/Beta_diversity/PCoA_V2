#############################################################
## Libraries
#############################################################

library(phyloseq)
library(ggplot2)
library(dplyr)
library(rlang)
library(ggrepel)
library(vegan)

#############################################################
## Input phyloseq object
#############################################################

ps <- ps_RD03050910

############################################################
## Optional: analyse one experiment only
#############################################################

experiment <- NULL

#############################################################
## Optional experiment filtering
#############################################################

if (!is.null(experiment)) {

    ps <- subset_samples(
        ps,
        exp %in% experiment
    )

}

#############################################################
## Optional cage filtering
#############################################################

exclude_cages <- c("RD05_cage1", "RD05_cage2")

## or exclude_cages <- NULL ##

if (!is.null(exclude_cages)) {

    ps <- subset_samples(
        ps,
        !(cage %in% exclude_cages)
    )

}

#############################################################
## Optional filtering
#############################################################

exclude_days <- NULL

## exclude_days <- c("d-4", "d-1") ##

#############################################################
## Optional day filtering
#############################################################

if (!is.null(exclude_days)) {

    ps <- subset_samples(
        ps,
        !(day %in% exclude_days)
    )

}

#############################################################
## Distance
#############################################################

## Available:
## "bray", "jaccard", "aitchison", "unifrac", "wunifrac"

distance_method <- "bray"

#############################################################
## Plot colouring
#############################################################

plot_by <- "group"

#############################################################
## Point shapes
#############################################################

shape_by <- "day"

## Examples:
## "day"
## "group"
## "cage"
## NULL

#############################################################
## Point options
#############################################################

point_size <- 3
point_alpha <- 0.90

## Thin black outline around points
point_shape <- 21
point_stroke <- 0.3

#############################################################
## Ellipse options
#############################################################

add_ellipses <- TRUE

ellipse_level <- 0.95

ellipse_fill <- TRUE
ellipse_alpha <- 0.08

ellipse_linewidth <- 0.6
ellipse_linetype <- "solid"

#############################################################
## Optional ordering
#############################################################

group_order <- c(
    "Untreated",
    "Antibiotic",
    "WT",
    "lsrK",
    "lsrR"
)


if (!inherits(ps, "phyloseq")) {
    stop("'ps' must be a phyloseq object.")
}

if (!plot_by %in% colnames(sample_data(ps))) {
    stop("'plot_by' is not present in sample_data(ps).")
}

if (!distance_method %in%
    c("bray","jaccard","aitchison","unifrac","wunifrac")) {

    stop("Unknown distance method.")
}

#############################################################
## Distance matrix
#############################################################

dist_matrix <- phyloseq::distance(
    ps,
    method = distance_method
)

#############################################################
## Statistics
#############################################################

perform_permanova <- TRUE

permanova_variable <- plot_by

permanova_permutations <- 999

#############################################################
## PERMANOVA
#############################################################

if (perform_permanova) {

    metadata$PERMANOVA_FACTOR <- metadata[[permanova_variable]]

    permanova <- vegan::adonis2(
        dist_matrix ~ PERMANOVA_FACTOR,
        data = metadata,
        permutations = permanova_permutations
    )

    print(permanova)

    permanova_R2 <- round(permanova$R2[1], 3)
    permanova_P  <- permanova$`Pr(>F)`[1]

}

title = paste0(
    "PCoA\n",
    "PERMANOVA (", permanova_variable, "): ",
    "R² = ", permanova_R2,
    ", p = ", signif(permanova_P, 3)
)

#############################################################
## PCoA
#############################################################

ord <- ordinate(
    ps,
    method = "PCoA",
    distance = dist_matrix
)

#############################################################
## Extract PCoA coordinates
#############################################################

scores <- as.data.frame(ord$vectors[, 1:2])

scores$SampleID <- rownames(scores)

#############################################################
## Metadata
#############################################################

metadata <- data.frame(sample_data(ps))

metadata$SampleID <- rownames(metadata)

scores <- dplyr::left_join(
    scores,
    metadata,
    by = "SampleID"
)


if ("group" %in% names(scores)) {

    scores$group <- factor(
        scores$group,
        levels = group_order
    )

}

#############################################################
## Labels for point annotation
#############################################################

scores$day_label <- gsub("^d", "", scores$day)


#############################################################
## Percentage of explained variance
#############################################################

variance <- round(
  100 * ord$values$Relative_eig[1:2],
  1
)

#############################################################
## PCoA plot
#############################################################

beta_plot <- ggplot(
  scores,
  aes(
    x = Axis.1,
    y = Axis.2,
    colour = .data[[plot_by]]
  )
)

#############################################################
## Ellipses
#############################################################

if (add_ellipses) {

  if (ellipse_fill) {

    beta_plot <- beta_plot +
      stat_ellipse(
        aes(
          group = .data[[plot_by]],
          fill = .data[[plot_by]],
          colour = .data[[plot_by]]
        ),
        geom = "polygon",
        alpha = ellipse_alpha,
        level = ellipse_level,
        linewidth = ellipse_linewidth,
        linetype = ellipse_linetype
      )

  } else {

    beta_plot <- beta_plot +
      stat_ellipse(
        aes(group = .data[[plot_by]]),
        level = ellipse_level,
        linewidth = ellipse_linewidth,
        linetype = ellipse_linetype
      )

  }

}

#############################################################
## Points
#############################################################

if (is.null(shape_by)) {

    beta_plot <- beta_plot +
        geom_point(
            aes(fill = .data[[plot_by]]),
            shape = 21,
            colour = "black",
            stroke = point_stroke,
            size = point_size + 1
        )

} else {

    beta_plot <- beta_plot +

        geom_point(
            aes(fill = .data[[plot_by]]),
            shape = 21,
            colour = "black",
            stroke = 0.4,
            size = point_size + 2
        ) +

        geom_text(
            aes(
                label = gsub("^d", "", .data[[shape_by]])
            ),
            colour = "black",
            fontface = "bold",
            size = point_size
        )

}

group_colors <- c(
    "Untreated" = "grey70",
    "Antibiotic" = "grey40",
    "WT" = "#03c2fe",
    "lsrK" = "#02d62e",
    "lsrR" = "#ff1130"
)

beta_plot <- beta_plot +
    scale_colour_manual(values = group_colors) +
    scale_fill_manual(values = group_colors)

#############################################################
## Labels and theme
#############################################################

beta_plot <- beta_plot +
    labs(
        title = paste0(
            "PCoA (Bray-Curtis)\n",
            "PERMANOVA (", permanova_variable, "): ",
            "R² = ", permanova_R2,
            ", p = ", signif(permanova_P, 3)
        ),
        x = paste0("PCoA1 (", variance[1], "%)"),
        y = paste0("PCoA2 (", variance[2], "%)")
    ) +
    microbiome_theme() +
    theme(
        legend.title = element_text(face = "bold"),
        plot.title = element_text(
            hjust = 0.5,
            face = "bold"
        )
    )

#############################################################
## Print
#############################################################

print(beta_plot)
