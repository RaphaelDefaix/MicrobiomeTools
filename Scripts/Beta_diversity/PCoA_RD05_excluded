#############################################################
## Libraries
#############################################################

library(phyloseq)
library(ggplot2)
library(dplyr)
library(rlang)
library(ggrepel)
library(vegan)

#############################################################
## Input phyloseq object
#############################################################

ps <- ps_RD03050910

#############################################################
## Optional experiment filtering
#############################################################

if (!is.null(experiment)) {

    ps <- subset_samples(
        ps,
        exp == experiment
    )

}

#############################################################
## Optional cage filtering
#############################################################

exclude_cages <- c("RD05_cage1", "RD05_cage2")

## or exclude_cages <- NULL ##

if (!is.null(exclude_cages)) {

    ps <- subset_samples(
        ps,
        !(cage %in% exclude_cages)
    )

}

#############################################################
## Optional day filtering
#############################################################

if (!is.null(exclude_days)) {

    ps <- subset_samples(
        ps,
        !(day %in% exclude_days)
    )

}

#############################################################
## Optional: analyse one experiment only
#############################################################

experiment <- NULL

#############################################################
## Distance
#############################################################

## Available:
## "bray", "jaccard", "aitchison", "unifrac", "wunifrac"

distance_method <- "bray"

#############################################################
## Plot colouring
#############################################################

plot_by <- "cage"

#############################################################
## Optional filtering
#############################################################

exclude_days <- NULL

#############################################################
## Point options
#############################################################

point_size <- 3
point_alpha <- 0.90

## Thin black outline around points
point_shape <- 21
point_stroke <- 0.3

#############################################################
## Ellipse options
#############################################################

add_ellipses <- TRUE

ellipse_level <- 0.95

ellipse_fill <- TRUE
ellipse_alpha <- 0.08

ellipse_linewidth <- 0.6
ellipse_linetype <- "solid"

#############################################################
## Optional ordering
#############################################################

group_order <- c(
    "Untreated",
    "Antibiotic",
    "WT",
    "lsrK",
    "lsrR"
)


if (!inherits(ps, "phyloseq")) {
    stop("'ps' must be a phyloseq object.")
}

if (!plot_by %in% colnames(sample_data(ps))) {
    stop("'plot_by' is not present in sample_data(ps).")
}

if (!distance_method %in%
    c("bray","jaccard","aitchison","unifrac","wunifrac")) {

    stop("Unknown distance method.")
}

#############################################################
## Distance matrix
#############################################################

dist_matrix <- phyloseq::distance(
    ps,
    method = distance_method
)

#############################################################
## PCoA
#############################################################

ord <- ordinate(
    ps,
    method = "PCoA",
    distance = dist_matrix
)

#############################################################
## Extract PCoA coordinates
#############################################################

scores <- as.data.frame(ord$vectors[, 1:2])

scores$SampleID <- rownames(scores)

#############################################################
## Metadata
#############################################################

metadata <- data.frame(sample_data(ps))

metadata$SampleID <- rownames(metadata)

scores <- dplyr::left_join(
    scores,
    metadata,
    by = "SampleID"
)


if ("group" %in% names(scores)) {

    scores$group <- factor(
        scores$group,
        levels = group_order
    )

}


#############################################################
## Percentage of explained variance
#############################################################

variance <- round(
  100 * ord$values$Relative_eig[1:2],
  1
)

#############################################################
## PCoA plot
#############################################################

beta_plot <- ggplot(
  scores,
  aes(
    x = Axis.1,
    y = Axis.2,
    colour = .data[[plot_by]]
  )
)

#############################################################
## Ellipses
#############################################################

if (add_ellipses) {

  if (ellipse_fill) {

    beta_plot <- beta_plot +
      stat_ellipse(
        aes(
          group = .data[[plot_by]],
          fill = .data[[plot_by]],
          colour = .data[[plot_by]]
        ),
        geom = "polygon",
        alpha = ellipse_alpha,
        level = ellipse_level,
        linewidth = ellipse_linewidth,
        linetype = ellipse_linetype
      )

  } else {

    beta_plot <- beta_plot +
      stat_ellipse(
        aes(group = .data[[plot_by]]),
        level = ellipse_level,
        linewidth = ellipse_linewidth,
        linetype = ellipse_linetype
      )

  }

}

#############################################################
## Points
#############################################################

beta_plot <- beta_plot +
  geom_point(
    aes(fill = .data[[plot_by]]),
    shape = point_shape,
    colour = "black",
    stroke = point_stroke,
    size = point_size,
    alpha = point_alpha
  )

#############################################################
## Labels and theme
#############################################################

beta_plot <- beta_plot +
  labs(
    title = "PCoA",
    x = paste0("PCoA1 (", variance[1], "%)"),
    y = paste0("PCoA2 (", variance[2], "%)")
  ) +
  microbiome_theme() +
  theme(
    legend.title = element_text(face = "bold"),
    plot.title = element_text(
      hjust = 0.5,
      face = "bold"
    )
  )

#############################################################
## Print
#############################################################

print(beta_plot)
